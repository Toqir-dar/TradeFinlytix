APP_NAME=TradeFinlytix
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False
EXPOSE_OPENAPI=false

HOST=0.0.0.0
PORT=8000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tradefinlytix_db?retryWrites=true&w=majority
MONGODB_DB_NAME=tradefinlytix_db

# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Must be exactly 32 bytes
AES_SECRET_KEY=CHANGE_ME_32_BYTES_EXACTLY______
HMAC_SECRET_KEY=CHANGE_ME_64_HEX_CHARS

AUTH_LOCKOUT_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

PASSWORD_REQUIRE_SYMBOL=false

RISK_SCORE_MEDIUM_THRESHOLD=30
RISK_SCORE_HIGH_THRESHOLD=55
RISK_SCORE_CRITICAL_THRESHOLD=80

AUDIT_STARTUP_VERIFY_CHAIN=false
AUDIT_STARTUP_VERIFY_LIMIT=5000
AUDIT_ABORT_STARTUP_WHEN_CHAIN_BROKEN=false
AUDIT_REJECT_NEW_EVENTS_WHEN_CHAIN_UNTRUSTED=false

PERSIST_RISK_SNAPSHOTS_ENABLED=true
SECURITY_ALERT_WEBHOOK_URL=

CSRF_PROTECTION_ENABLED=false
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Set ENABLE_BOOTSTRAP=false after the first successful deploy
ENABLE_BOOTSTRAP=true
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BOOTSTRAP_CISO_EMAIL=ciso@yourdomain.com
BOOTSTRAP_CISO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Redis runs as a sidecar container in production
REDIS_URL=redis://redis:6379/0

# Set to your EC2 domain or IP — must match what the browser uses
ALLOWED_ORIGINS=http://your-ec2-ip-or-domain

MODELS_DIR=app/ml_engine/saved_models

GROQ_API_KEY=YOUR_GROQ_API_KEY

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
